# Шаблон: образ nginx подставляет ${KURAI_DOMAIN} из окружения при старте.
# Сайт и API на одном домене: /api/ — Django, всё остальное — Next.js.

server {
    listen 80;
    listen [::]:80;
    server_name ${KURAI_DOMAIN};

    # проверка домена при выдаче и продлении сертификата
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${KURAI_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${KURAI_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${KURAI_DOMAIN}/privkey.pem;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # вложения в чат — до 50 МБ (files/api.py), с запасом на заголовки формы
    client_max_body_size 55m;

    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # адрес клиента перезаписываем, а не дописываем: API доверяет заголовку,
    # по нему считаются лимиты попыток входа
    proxy_set_header X-Forwarded-For $remote_addr;

    location /api/ {
        proxy_pass http://api:8000;
        # поток ответа API помечает X-Accel-Buffering: no — nginx отдаёт его сразу
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://web:3000;
        # для /api/ этот заголовок ставит сам Django
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}
