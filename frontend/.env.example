# Public workspace API. Leave empty to keep the local interface preview.
NEXT_PUBLIC_KURAI_API_BASE_URL=http://localhost:8000
# Canonical public URL used for metadata and social sharing.
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Вход через Telegram: имя бота без @ (тот же бот, чей токен у сервера в TELEGRAM_BOT_TOKEN).
# Пусто — кнопки входа через Telegram на сайте нет.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
