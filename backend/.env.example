# Development defaults are safe only for local use. Production must provide a random secret.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Enables the deterministic local text provider for an end-to-end MVP demo.
KURAI_LOCAL_EXECUTE_RUNS=1
# Leave this at 0 locally. Docker production uses Redis and Celery instead.
KURAI_QUEUE_RUNS=0
# Keep this server-only. Once supplied, local executions use OpenRouter too.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=KURAI
