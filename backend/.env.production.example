DJANGO_DEBUG=0
KURAI_ENV_FILE=.env.production
DJANGO_SECRET_KEY=replace-with-a-50-plus-character-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
DATABASE_URL=postgresql://kurai:replace-with-a-strong-password@postgres:5432/kurai
POSTGRES_PASSWORD=replace-with-a-strong-password
CELERY_BROKER_URL=redis://redis:6379/0
KURAI_EVENT_REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
KURAI_QUEUE_RUNS=1
KURAI_LOCAL_EXECUTE_RUNS=0
KURAI_RUN_RATE_LIMIT_WINDOW_SECONDS=60
KURAI_RUN_QUOTE_RATE_LIMIT_COUNT=30
KURAI_RUN_START_RATE_LIMIT_COUNT=12
KURAI_SSE_MAX_SECONDS=30
KURAI_SSE_HEARTBEAT_SECONDS=15
KURAI_CATALOG_MAX_AGE_SECONDS=43200
KURAI_RESEARCH_SEARCH_ENGINE=exa
KURAI_RESEARCH_MAX_RESULTS=5
KURAI_RESEARCH_MAX_TOTAL_RESULTS=10
KURAI_RESEARCH_MAX_USES=2
KURAI_RESEARCH_MAX_TOOL_CALLS=3
KURAI_RESEARCH_MAX_SOURCE_CHARACTERS=4000
KURAI_RESEARCH_SEARCH_COST_USD_PER_USE=0.007
OPENROUTER_API_KEY=replace-with-your-openrouter-server-key
OPENROUTER_SITE_URL=https://app.example.com
OPENROUTER_APP_NAME=KURAI
SECURE_HSTS_SECONDS=31536000
# Mail: password reset and email confirmation need a real SMTP service; without it /status reports mail_unconfigured.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=KURAI <no-reply@example.com>
KURAI_FRONTEND_URL=https://app.example.com
PASSWORD_RESET_TIMEOUT_SECONDS=7200
KURAI_EMAIL_VERIFY_MAX_AGE_SECONDS=259200
